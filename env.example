# Browser-safe values only belong in variables prefixed with VITE_.
# GEMINI_API_KEY is read only by the Node server.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

# The default live source. Override without changing code.
GOOGLE_SHEET_CSV_URL=https://docs.google.com/spreadsheets/d/1iTQL8KcV29LypY3AIVv8zM7lrMjkuwijluLNAoTqLkI/gviz/tq?tqx=out:csv

# Local PostgreSQL. Cloud Run can instead use DB_* plus INSTANCE_UNIX_SOCKET.
DATABASE_URL=postgresql://mro:mro@localhost:5432/mro_intelligence
DB_SSL=false
DB_POOL_MAX=5

# Single-user gate. Leave blank only for local development.
OWNER_ACCESS_KEY=
SESSION_SECRET=
INGEST_TOKEN=

PORT=8080
NODE_ENV=development
